diff --git a/src/cpu_attention.cpp b/src/cpu_attention.cpp
new file mode 100644
index 0000000..f7798c8
--- /dev/null
+++ b/src/cpu_attention.cpp
@@ -0,0 +1,56 @@
+#include "cpu_attention.hpp"
+#include "ggml-cpu/vec.h"
+
+#include <cmath>
+#include <vector>
+
+namespace mt {
+namespace {
+void eager_decode_attention(ggml_tensor* dst, const ggml_tensor* q,
+                            const ggml_tensor* k, const ggml_tensor* v,
+                            int ith, int nth, void*) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && k->type == GGML_TYPE_F32 && v->type == GGML_TYPE_F32);
+    GGML_ASSERT(q->ne[1] == 1 && q->ne[0] == k->ne[0] && k->ne[1] == v->ne[0]);
+    GGML_ASSERT(q->ne[0] == v->ne[1] && k->ne[2] == v->ne[2] && k->ne[3] == v->ne[3]);
+    GGML_ASSERT(q->ne[2] % k->ne[2] == 0 && q->ne[3] % k->ne[3] == 0);
+    GGML_ASSERT(q->nb[0] == sizeof(float) && k->nb[0] == sizeof(float) && v->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    const int dim = static_cast<int>(q->ne[0]);
+    const int keys = static_cast<int>(k->ne[1]);
+    const float scale = 1.0f/std::sqrt(static_cast<float>(dim));
+    thread_local std::vector<float> scores, weights;
+    scores.resize(keys); weights.resize(keys);
+    const int64_t head_ratio = q->ne[2]/k->ne[2];
+    const int64_t batch_ratio = q->ne[3]/k->ne[3];
+    for (int64_t row = ith; row < q->ne[2]*q->ne[3]; row += nth) {
+        const int64_t head = row%q->ne[2], batch = row/q->ne[2];
+        const int64_t kh = head/head_ratio, kb = batch/batch_ratio;
+        const float* query = reinterpret_cast<const float*>(static_cast<const char*>(q->data) + head*q->nb[2] + batch*q->nb[3]);
+        const char* key_base = static_cast<const char*>(k->data) + kh*k->nb[2] + kb*k->nb[3];
+        const char* value_base = static_cast<const char*>(v->data) + kh*v->nb[2] + kb*v->nb[3];
+        float* out = reinterpret_cast<float*>(static_cast<char*>(dst->data) + head*dst->nb[2] + batch*dst->nb[3]);
+        for (int j = 0; j < keys; ++j) {
+            const float* key = reinterpret_cast<const float*>(key_base + j*k->nb[1]);
+            ggml_vec_dot_f32(dim, &scores[j], 0, key, 0, query, 0, 1);
+        }
+        // This is the eager reference's full-row normalization, not online softmax.
+        ggml_vec_scale_f32(keys, scores.data(), scale);
+        float max = -INFINITY;
+        ggml_vec_max_f32(keys, &max, scores.data());
+        ggml_float sum = ggml_vec_soft_max_f32(keys, weights.data(), scores.data(), max);
+        GGML_ASSERT(sum > 0.0);
+        sum = 1.0/sum;
+        ggml_vec_scale_f32(keys, weights.data(), sum);
+        for (int d = 0; d < dim; ++d) {
+            const float* values = reinterpret_cast<const float*>(value_base + d*v->nb[1]);
+            ggml_vec_dot_f32(keys, &out[d], 0, values, 0, weights.data(), 0, 1);
+        }
+    }
+}
+}
+
+ggml_tensor* cpu_decode_attention(ggml_context* ctx, ggml_tensor* q,
+                                  ggml_tensor* k, ggml_tensor* transposed_v) {
+    return ggml_map_custom3(ctx, q, k, transposed_v, eager_decode_attention, GGML_N_TASKS_MAX, nullptr);
+}
+}
